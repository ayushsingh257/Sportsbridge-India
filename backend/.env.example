# Backend Environment Configuration Template
ENVIRONMENT=development
APP_NAME="Bharat Sports Grant API"
API_V1_PREFIX=/api/v1
SECRET_KEY=template_secret_key_change_in_production_not_real_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sportsbridge_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000"]

# Storage & Uploads
UPLOAD_DIR=./uploads

# Development Simulated Services
ENABLE_MOCK_OTP=true
ENABLE_MOCK_DISBURSEMENT=true
